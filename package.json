{
  "name": "masters-auction",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "deploy": "npm run build:frontend && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply masters-auction-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply masters-auction-db --remote"
  },
  "dependencies": {
    "hono": "^4.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "typescript": "^5.5.0",
    "wrangler": "^4.83.0"
  }
}
